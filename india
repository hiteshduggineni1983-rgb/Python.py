<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Happy Independence Day India 🇮🇳</title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      background: #eee;

      font-family: Arial, sans-serif;

      overflow-x: hidden;
      overflow-y: auto;
    }


    /* =========================
       INDIA CARD
       ========================= */

    .india-btn {
      width: 320px;
      min-height: 230px;

      padding: 20px;

      background: white;
      color: #000080;

      border: 3px solid #000080;
      border-radius: 18px;

      cursor: pointer;

      margin-bottom: 30px;

      box-shadow:
        0 8px 20px rgba(0, 0, 0, 0.2);

      transition: 0.3s ease;
    }


    .india-btn:hover {
      transform: scale(1.05);

      box-shadow:
        0 12px 25px rgba(0, 0, 0, 0.3);
    }


    .india-btn:active {
      transform: scale(0.97);
    }


    .india-title {
      font-size: 30px;
      font-weight: bold;

      padding: 10px;

      border-top: 8px solid #ff9933;
      border-bottom: 8px solid #138808;
    }


    .india-number {
      font-size: 42px;
      font-weight: bold;

      margin-top: 15px;
      margin-bottom: 5px;
    }


    .india-info {
      font-size: 15px;

      line-height: 1.5;

      color: #333;
    }


    /* =========================
       HAPPY INDEPENDENCE DAY
       ========================= */

    .wish {
      font-size: 32px;
      font-weight: bold;

      text-align: center;

      margin-bottom: 25px;

      opacity: 0;

      transform: scale(0.5);

      display: none;
    }


    .wish.show {
      display: block;

      animation:
        wishAnimation 1.5s ease forwards;
    }


    @keyframes wishAnimation {

      0% {
        opacity: 0;
        transform: scale(0.5);
      }

      60% {
        opacity: 1;
        transform: scale(1.15);
      }

      100% {
        opacity: 1;
        transform: scale(1);
      }

    }


    .happy {
      color: #ff9933;
    }


    .independence {
      color: #000080;
    }


    .day {
      color: #138808;
    }


    /* =========================
       INDIAN FLAG
       ========================= */

    .flag {
      width: 600px;
      height: 400px;

      position: relative;

      box-shadow:
        0 5px 15px rgba(0, 0, 0, 0.2);

      opacity: 0;

      transform:
        translateX(-500px)
        rotate(-8deg);

      transition:
        all 1.2s ease;
    }


    .flag.show {
      opacity: 1;

      transform:
        translateX(0)
        rotate(0deg);

      animation:
        wave 2s ease-in-out;
    }


    @keyframes wave {

      0% {
        transform:
          translateX(-500px)
          rotate(-8deg);
      }

      40% {
        transform:
          translateX(30px)
          rotate(3deg);
      }

      60% {
        transform:
          translateX(-15px)
          rotate(-2deg);
      }

      80% {
        transform:
          translateX(8px)
          rotate(1deg);
      }

      100% {
        transform:
          translateX(0)
          rotate(0deg);
      }

    }


    /* =========================
       FLAG COLORS
       ========================= */

    .saffron {
      height: 33.33%;
      background: #ff9933;
    }


    .white {
      height: 33.33%;

      background: white;

      display: flex;

      justify-content: center;
      align-items: center;
    }


    .green {
      height: 33.34%;
      background: #138808;
    }


    /* =========================
       ASHOKA CHAKRA
       ========================= */

    .chakra {
      width: 80px;
      height: 80px;

      border: 4px solid #000080;

      border-radius: 50%;

      position: relative;

      box-sizing: border-box;

      display: flex;

      justify-content: center;
      align-items: center;
    }


    .spoke {
      position: absolute;

      width: 2px;
      height: 70px;

      background: #000080;

      top: 1px;
      left: 37px;

      transform-origin:
        center 39px;
    }


    /* 24 SPOKES */

    .spoke:nth-child(1)  { transform: rotate(0deg); }
    .spoke:nth-child(2)  { transform: rotate(15deg); }
    .spoke:nth-child(3)  { transform: rotate(30deg); }
    .spoke:nth-child(4)  { transform: rotate(45deg); }
    .spoke:nth-child(5)  { transform: rotate(60deg); }
    .spoke:nth-child(6)  { transform: rotate(75deg); }
    .spoke:nth-child(7)  { transform: rotate(90deg); }
    .spoke:nth-child(8)  { transform: rotate(105deg); }
    .spoke:nth-child(9)  { transform: rotate(120deg); }
    .spoke:nth-child(10) { transform: rotate(135deg); }
    .spoke:nth-child(11) { transform: rotate(150deg); }
    .spoke:nth-child(12) { transform: rotate(165deg); }
    .spoke:nth-child(13) { transform: rotate(180deg); }
    .spoke:nth-child(14) { transform: rotate(195deg); }
    .spoke:nth-child(15) { transform: rotate(210deg); }
    .spoke:nth-child(16) { transform: rotate(225deg); }
    .spoke:nth-child(17) { transform: rotate(240deg); }
    .spoke:nth-child(18) { transform: rotate(255deg); }
    .spoke:nth-child(19) { transform: rotate(270deg); }
    .spoke:nth-child(20) { transform: rotate(285deg); }
    .spoke:nth-child(21) { transform: rotate(300deg); }
    .spoke:nth-child(22) { transform: rotate(315deg); }
    .spoke:nth-child(23) { transform: rotate(330deg); }
    .spoke:nth-child(24) { transform: rotate(345deg); }


    /* =========================
       PARAGRAPH
       ========================= */

    .message {
      width: 600px;
      max-width: 90%;

      margin-top: 25px;
      margin-bottom: 40px;

      padding: 20px;

      text-align: center;

      font-size: 18px;

      line-height: 1.7;

      color: #333;

      background: white;

      border-radius: 15px;

      border-top: 5px solid #ff9933;
      border-bottom: 5px solid #138808;

      box-shadow:
        0 5px 15px rgba(0, 0, 0, 0.15);

      opacity: 0;

      transform:
        translateY(40px);

      display: none;
    }


    .message.show {
      display: block;

      animation:
        messageAnimation 1.2s ease forwards;
    }


    @keyframes messageAnimation {

      0% {
        opacity: 0;
        transform: translateY(40px);
      }

      100% {
        opacity: 1;
        transform: translateY(0);
      }

    }


    /* =========================
       FLOWER CONTAINER
       ========================= */

    .flowers {
      position: fixed;

      top: 0;
      left: 0;

      width: 100%;
      height: 100%;

      pointer-events: none;

      overflow: hidden;

      display: none;

      z-index: 100;
    }


    .flowers.show {
      display: block;
    }


    /* =========================
       FALLING FLOWERS
       ========================= */

    .flower {
      position: absolute;

      top: -60px;

      font-size: 30px;

      animation:
        fall linear forwards;
    }


    @keyframes fall {

      0% {

        transform:
          translateY(-60px)
          translateX(0)
          rotate(0deg);

        opacity: 1;
      }


      25% {

        transform:
          translateY(25vh)
          translateX(30px)
          rotate(90deg);

        opacity: 1;
      }


      50% {

        transform:
          translateY(50vh)
          translateX(-30px)
          rotate(180deg);

        opacity: 0.9;
      }


      75% {

        transform:
          translateY(75vh)
          translateX(30px)
          rotate(270deg);

        opacity: 0.7;
      }


      100% {

        transform:
          translateY(110vh)
          translateX(-20px)
          rotate(360deg);

        opacity: 0;
      }

    }


    /* =========================
       MOBILE
       ========================= */

    @media (max-width: 700px) {

      body {
        padding: 20px 0;
      }


      .india-btn {
        width: 280px;
      }


      .india-title {
        font-size: 25px;
      }


      .india-number {
        font-size: 36px;
      }


      .wish {
        font-size: 25px;
      }


      .flag {
        width: 90vw;
        height: 60vw;
      }


      .chakra {
        width: 60px;
        height: 60px;

        border-width: 3px;
      }


      .spoke {
        width: 2px;
        height: 52px;

        top: 1px;
        left: 27px;

        transform-origin:
          center 29px;
      }


      .message {
        font-size: 16px;
        padding: 15px;
      }

    }

  </style>

</head>


<body>


  <!-- =========================
       INDIA CARD
       ========================= -->

  <button
    class="india-btn"
    onclick="celebrate()"
  >

    <div class="india-title">
      🇮🇳 INDIA 🇮🇳
    </div>


    <div class="india-number">
      15
    </div>


    <div class="india-info">
      August<br>
      Independence Day
    </div>

  </button>



  <!-- =========================
       WISH
       ========================= -->

  <div
    class="wish"
    id="wish"
  >

    <span class="happy">
      HAPPY
    </span>

    <span class="independence">
      INDEPENDENCE
    </span>

    <span class="day">
      DAY 🇮🇳
    </span>

  </div>



  <!-- =========================
       FLAG
       ========================= -->

  <div
    class="flag"
    id="flag"
  >

    <!-- SAFFRON -->

    <div class="saffron"></div>


    <!-- WHITE -->

    <div class="white">

      <div class="chakra">

        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>

        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>
        <div class="spoke"></div>

      </div>

    </div>


    <!-- GREEN -->

    <div class="green"></div>

  </div>



  <!-- =========================
       PARAGRAPH
       ========================= -->

  <p
    class="message"
    id="message"
  >

    🇮🇳 On this Independence Day, let us remember the
    sacrifices of our freedom fighters and celebrate the
    spirit of freedom, unity, and pride. Let us work together
    to make our country stronger, brighter, and better for
    future generations. 🇮🇳

    <br><br>

    <strong>
      Jai Hind! 🇮🇳
    </strong>

  </p>



  <!-- =========================
       FLOWERS
       ========================= -->

  <div
    class="flowers"
    id="flowers"
  ></div>



  <!-- =========================
       JAVASCRIPT
       ========================= -->

  <script>

    let flowerTimer;


    function celebrate() {

      const wish =
        document.getElementById("wish");

      const flag =
        document.getElementById("flag");

      const message =
        document.getElementById("message");

      const flowers =
        document.getElementById("flowers");


      /*
        STEP 1
        Show wish
      */

      wish.classList.add("show");


      /*
        STEP 2
        Show flag
      */

      setTimeout(function () {

        flag.classList.add("show");

      }, 500);


      /*
        STEP 3
        Show paragraph
      */

      setTimeout(function () {

        message.classList.add("show");

      }, 2600);


      /*
        STEP 4
        Start flower shower
      */

      setTimeout(function () {

        flowers.classList.add("show");

        startFlowerShower();

      }, 3800);

    }



    /* =========================
       FLOWER SHOWER
       ========================= */

    function startFlowerShower() {

      /* Create flowers immediately */

      createFlower();


      /*
        Keep creating new flowers
        continuously
      */

      flowerTimer =
        setInterval(function () {

          createFlower();

        }, 180);

    }



    /* =========================
       CREATE ONE FLOWER
       ========================= */

    function createFlower() {

      const container =
        document.getElementById("flowers");


      const flower =
        document.createElement("div");


      flower.classList.add("flower");


      const flowerTypes = [

        "🌸",
        "🌼",
        "🌺",
        "🌻",
        "🪷"

      ];


      /* Random flower */

      flower.innerHTML =
        flowerTypes[
          Math.floor(
            Math.random() *
            flowerTypes.length
          )
        ];


      /* Random horizontal position */

      flower.style.left =
        Math.random() * 100 + "%";


      /* Random size */

      flower.style.fontSize =
        (18 + Math.random() * 25) + "px";


      /*
        Faster falling speed
        2 - 4 seconds
      */

      flower.style.animationDuration =
        (2 + Math.random() * 2) + "s";


      /* Random animation delay */

      flower.style.animationDelay =
        (Math.random() * 0.5) + "s";


      container.appendChild(flower);


      /*
        Remove flower after animation
        so the page stays smooth
      */

      setTimeout(function () {

        flower.remove();

      }, 5000);

    }

  </script>


</body>

</html>