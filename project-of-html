<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTML Master - Learn & Play</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #6366f1;
            --secondary: #a855f7;
            --accent: #f59e0b;
            --bg: #0f172a;
            --card: #1e293b;
            --text: #f8fafc;
            --success: #22c55e;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

        body {
            background-color: var(--bg);
            color: var(--text);
            overflow-x: hidden;
        }

        /* --- Color World UI --- */
        .color-world {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        header {
            padding: 1rem 2rem;
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--primary);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .stats { display: flex; gap: 20px; }
        .stat-item { background: #334155; padding: 5px 15px; border-radius: 20px; border: 1px solid var(--primary); }
        .xp-text { color: var(--accent); font-weight: bold; }

        /* --- Layout --- */
        .main-container {
            display: grid;
            grid-template-columns: 300px 1fr 400px;
            height: calc(100vh - 70px);
        }

        /* --- Sidebar Navigation --- */
        .sidebar {
            background: var(--card);
            padding: 1rem;
            overflow-y: auto;
            border-right: 1px solid #334155;
        }

        .level-card {
            background: #334155;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
            border-left: 5px solid transparent;
        }

        .level-card:hover { background: #475569; }
        .level-card.active { border-left-color: var(--primary); background: #1e1b4b; }
        .level-card.locked { opacity: 0.5; cursor: not-allowed; }

        /* --- Content Area --- */
        .content-area {
            padding: 2rem;
            overflow-y: auto;
            background: rgba(15, 23, 42, 0.5);
        }

        .explanation-card {
            background: var(--card);
            padding: 20px;
            border-radius: 15px;
            line-height: 1.6;
            margin-bottom: 20px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3);
        }

        .analogy { font-style: italic; color: #94a3b8; border-left: 3px solid var(--accent); padding-left: 10px; margin: 10px 0; }
        code { background: #000; color: #ef4444; padding: 2px 5px; border-radius: 4px; }

        /* --- Code Editor --- */
        .editor-container {
            background: #000;
            display: flex;
            flex-direction: column;
            border-left: 1px solid #334155;
        }

        .editor-header {
            background: #1e293b;
            padding: 10px;
            display: flex;
            justify-content: space-between;
        }

        textarea {
            width: 100%;
            height: 50%;
            background: #1a1a1a;
            color: #d1d5db;
            padding: 15px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 14px;
            border: none;
            resize: none;
            outline: none;
        }

        #preview {
            width: 100%;
            height: 50%;
            background: white;
            border: none;
        }

        .btn {
            padding: 8px 16px;
            border-radius: 5px;
            border: none;
            cursor: pointer;
            font-weight: bold;
            transition: 0.2s;
        }

        .btn-run { background: var(--success); color: white; }
        .btn-run:hover { background: #16a34a; }

        /* --- Quiz & Game --- */
        .quiz-container {
            margin-top: 20px;
            padding: 20px;
            background: #1e1b4b;
            border-radius: 10px;
            display: none;
        }

        .level-up-modal {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            background: var(--card);
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            z-index: 1000;
            border: 3px solid var(--accent);
            transition: 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .level-up-modal.show { transform: translate(-50%, -50%) scale(1); }

        .progress-bar {
            width: 100%;
            height: 10px;
            background: #334155;
            border-radius: 5px;
            margin-top: 5px;
        }

        .progress-fill {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: 0.5s;
        }

        .mini-game-area {
            background: #4338ca;
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            display: none;
        }

    </style>
</head>
<body>

<div class="color-world">
    <header>
        <h1 style="color: var(--primary)"><i class="fas fa-rocket"></i> HTML Master</h1>
        <div class="stats">
            <div class="stat-item">Level: <span id="user-level">1</span></div>
            <div class="stat-item">XP: <span id="user-xp" class="xp-text">0</span></div>
            <div class="stat-item">Streak: <span id="user-streak">🔥 1</span></div>
        </div>
    </header>

    <div class="main-container">
        <!-- Sidebar -->
        <div class="sidebar" id="level-list">
            <!-- Levels generated by JS -->
        </div>

        <!-- Content -->
        <div class="content-area">
            <div id="learning-content">
                <div class="explanation-card">
                    <h2 id="topic-title">Welcome to HTML Master</h2>
                    <p id="topic-desc">Select a level from the left to start your journey into the color world of web development!</p>
                    <div id="topic-details"></div>
                </div>

                <div class="quiz-container" id="quiz-box">
                    <h3><i class="fas fa-question-circle"></i> Quick Quiz</h3>
                    <div id="quiz-content"></div>
                    <button class="btn btn-run" style="margin-top:10px" onclick="checkQuiz()">Submit Answer</button>
                </div>

                <!-- Mini Project Section (Every 5 levels) -->
                <div class="mini-game-area" id="project-box">
                    <h3><i class="fas fa-star"></i> Milestone Project</h3>
                    <p id="project-desc"></p>
                    <button class="btn btn-run" onclick="completeProject()">Complete Project</button>
                </div>
            </div>
        </div>

        <!-- Editor -->
        <div class="editor-container">
            <div class="editor-header">
                <span><i class="fas fa-code"></i> Interactive Editor</span>
                <button class="btn btn-run" onclick="runCode()">Run Code <i class="fas fa-play"></i></button>
            </div>
            <textarea id="html-code" placeholder="Write your HTML here..."></textarea>
            <div class="editor-header">
                <span><i class="fas fa-eye"></i> Live Preview</span>
            </div>
            <iframe id="preview"></iframe>
        </div>
    </div>
</div>

<!-- Popups -->
<div class="level-up-modal" id="level-modal">
    <h1 style="font-size: 3rem; color: var(--accent);">LEVEL UP!</h1>
    <p style="font-size: 1.5rem; margin: 20px 0;">You've mastered a new skill!</p>
    <div style="font-size: 4rem;">🏆</div>
    <button class="btn btn-run" style="margin-top: 20px;" onclick="closeModal()">Continue Journey</button>
</div>

<script>
    // --- APP DATA ---
    const levelsData = [
        {
            id: 1,
            title: "LEVEL 1 — HTML BASICS",
            desc: "What is HTML?",
            explanation: `HTML stands for <b>HyperText Markup Language</b>. It is the skeletal structure of every website you see.`,
            analogy: "Think of HTML as the skeletal structure of a house. It defines where the walls, doors, and windows go, but doesn't handle the paint (CSS) or the electricity (JS).",
            syntax: "&lt;tagname&gt; Content goes here... &lt;/tagname&gt;",
            code: "<h1>Hello World!</h1>\n<p>Welcome to my first page.</p>",
            quiz: {
                q: "What does HTML stand for?",
                options: ["HyperText Markup Language", "HighText Machine Language", "HyperTool Multi Language"],
                a: 0
            }
        },
        {
            id: 2,
            title: "LEVEL 2 — TEXT ELEMENTS",
            desc: "Headings and Paragraphs",
            explanation: "Headings (h1 to h6) define the importance of your titles. &lt;p&gt; defines a paragraph.",
            analogy: "A newspaper uses a big headline (H1), sub-headlines (H2), and columns of text (P).",
            syntax: "&lt;h1&gt;Main Title&lt;/h1&gt;",
            code: "<h1>Main Headline</h1>\n<h2>Sub-headline</h2>\n<p>This is a paragraph of text.</p>",
            quiz: {
                q: "Which tag is used for the largest heading?",
                options: ["<h6>", "<head>", "<h1>"],
                a: 2
            }
        },
        {
            id: 3,
            title: "LEVEL 3 — LINKS",
            desc: "The Anchor Tag",
            explanation: "Links are created using the &lt;a&gt; tag with the 'href' attribute.",
            analogy: "A link is like a portal in a game that teleports you to a different room (webpage).",
            syntax: "&lt;a href='url'&gt;Click Me&lt;/a&gt;",
            code: "<a href='https://google.com' target='_blank'>Visit Google</a>",
            quiz: {
                q: "Which attribute is required for a link to work?",
                options: ["src", "href", "link"],
                a: 1
            }
        },
        {
            id: 4,
            title: "LEVEL 4 — IMAGES",
            desc: "Visual Content",
            explanation: "The &lt;img&gt; tag is a self-closing tag used to embed images.",
            analogy: "An image tag is like a picture frame; you have to tell it where the picture (SRC) is.",
            syntax: "&lt;img src='image.jpg' alt='description'&gt;",
            code: "<img src='https://via.placeholder.com/150' alt='A nice placeholder'>",
            quiz: {
                q: "Is <img> a self-closing tag?",
                options: ["Yes", "No"],
                a: 0
            }
        },
        {
            id: 5,
            title: "LEVEL 5 — PROJECT 1",
            desc: "Mini Portfolio",
            explanation: "Time to combine everything! Use Headings, Text, Links, and Images to build a basic profile.",
            isProject: true,
            projectGoal: "Create a page with your Name (H1), a Bio (P), a link to your social media (A), and a profile picture (IMG).",
            code: "<!-- Build your Portfolio here! -->"
        }
        // ... Levels 6-20 would be added similarly
    ];

    // --- STATE MANAGEMENT ---
    let currentLevelIndex = 0;
    let xp = 0;
    let unlockedLevels = 1;

    // --- CORE FUNCTIONS ---
    function init() {
        renderLevelList();
        loadLevel(0);
        updateStats();
    }

    function renderLevelList() {
        const list = document.getElementById('level-list');
        list.innerHTML = '';
        levelsData.forEach((lvl, index) => {
            const div = document.createElement('div');
            div.className = `level-card ${index >= unlockedLevels ? 'locked' : ''} ${index === currentLevelIndex ? 'active' : ''}`;
            div.innerHTML = `
                <h4>${lvl.title}</h4>
                <small>${lvl.desc}</small>
                <div class="progress-bar"><div class="progress-fill" style="width: ${index < currentLevelIndex ? '100%' : '0%'}"></div></div>
            `;
            if (index < unlockedLevels) {
                div.onclick = () => loadLevel(index);
            }
            list.appendChild(div);
        });
    }

    function loadLevel(index) {
        currentLevelIndex = index;
        const level = levelsData[index];
        
        document.getElementById('topic-title').innerText = level.title;
        document.getElementById('topic-desc').innerText = level.desc;
        
        let detailsHtml = `
            <div class="explanation-card">
                <p>${level.explanation}</p>
                <div class="analogy"><b>Analogy:</b> ${level.analogy}</div>
                <p><b>Syntax:</b> <code>${level.syntax}</code></p>
            </div>
        `;
        document.getElementById('topic-details').innerHTML = detailsHtml;

        // Reset Quiz
        const quizBox = document.getElementById('quiz-box');
        const projectBox = document.getElementById('project-box');

        if (level.isProject) {
            quizBox.style.display = 'none';
            projectBox.style.display = 'block';
            document.getElementById('project-desc').innerText = level.projectGoal;
        } else {
            projectBox.style.display = 'none';
            quizBox.style.display = 'block';
            renderQuiz(level.quiz);
        }

        // Set Code
        document.getElementById('html-code').value = level.code;
        runCode();
        renderLevelList();
    }

    function renderQuiz(quiz) {
        const container = document.getElementById('quiz-content');
        container.innerHTML = `<p>${quiz.q}</p>`;
        quiz.options.forEach((opt, i) => {
            container.innerHTML += `
                <div style="margin: 5px 0;">
                    <input type="radio" name="quiz" value="${i}" id="opt${i}">
                    <label for="opt${i}">${opt}</label>
                </div>
            `;
        });
    }

    function checkQuiz() {
        const selected = document.querySelector('input[name="quiz"]:checked');
        if (!selected) return alert("Please select an answer!");

        const level = levelsData[currentLevelIndex];
        if (parseInt(selected.value) === level.quiz.a) {
            addXP(50);
            levelComplete();
        } else {
            alert("Wrong answer! Try again.");
        }
    }

    function completeProject() {
        addXP(200);
        levelComplete();
    }

    function levelComplete() {
        if (currentLevelIndex + 1 >= unlockedLevels) {
            unlockedLevels++;
            document.getElementById('level-modal').classList.add('show');
        } else {
            loadLevel(currentLevelIndex + 1);
        }
    }

    function closeModal() {
        document.getElementById('level-modal').classList.remove('show');
        if (currentLevelIndex + 1 < levelsData.length) {
            loadLevel(currentLevelIndex + 1);
        }
    }

    function addXP(amount) {
        xp += amount;
        updateStats();
    }

    function updateStats() {
        document.getElementById('user-xp').innerText = xp;
        document.getElementById('user-level').innerText = unlockedLevels;
    }

    function runCode() {
        const code = document.getElementById('html-code').value;
        const preview = document.getElementById('preview').contentWindow.document;
        preview.open();
        preview.write(code);
        preview.close();
    }

    // Initialize the app
    init();

</script>
</body>
</html>