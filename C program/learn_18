#include <stdio.h>

int main() {
    int choice;
    int a, b;

    do {
        printf("\n1. Add\n");
        printf("2. Subtract\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            printf("Enter two numbers: ");
            scanf("%d %d", &a, &b);
            printf("Result = %d\n", a + b);
        }
        else if (choice == 2) {
            printf("Enter two numbers: ");
            scanf("%d %d", &a, &b);
            printf("Result = %d\n", a - b);
        }
        else if (choice == 3) {
            printf("Goodbye!");
        }
        else {
            printf("Invalid choice!");
        }

    } while (choice != 3);

    return 0;
}